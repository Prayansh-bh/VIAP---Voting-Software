// ============================================================================
// Production PostgreSQL Prisma Schema for kondapi-tdp-connect
// Hierarchy: State -> Zone -> Parliament -> Constituency -> Mandal -> Village -> Booth -> 100-Voter In-Charge -> Voter
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum OrgHierarchyLevel {
  STATE
  ZONE
  PARLIAMENT
  CONSTITUENCY
  MANDAL
  VILLAGE
  BOOTH
  VOTER_GROUP
}

enum RoleType {
  SUPER_ADMIN
  HIGH_COMMAND
  STATE_ADMIN
  ZONE_INCHARGE
  PARLIAMENT_INCHARGE
  CONSTITUENCY_INCHARGE
  MANDAL_INCHARGE
  VILLAGE_INCHARGE
  BOOTH_PRESIDENT
  BOOTH_INCHARGE
  VOTER_100_INCHARGE
  POLLING_AGENT
  VOLUNTEER
  VIEWER
}

enum AccountStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DEACTIVATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum RelationType {
  FATHER
  HUSBAND
  MOTHER
  OTHER
}

enum VoterStatus {
  ACTIVE
  SHIFTED
  DECEASED
  DUPLICATE
  FAKE
  DOUBTFUL
  UNKNOWN
}

enum SurveyStatus {
  NOT_SURVEYED
  SURVEYED
  VERIFIED
}

enum VoterLocationStatus {
  LOCAL
  MIGRATED
}

enum VoteStatus {
  NOT_VOTED
  VOTED
  VOTE_DONE
}

enum FakeVoterStatus {
  FLAGGED
  UNDER_VERIFICATION
  VERIFIED_ISSUE
  RESOLVED
  DISMISSED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TrainingStatus {
  ASSIGNED
  WATCHED
  COMPLETED
}

enum GroundReportType {
  GENERAL_UPDATE
  COMPLAINT_ISSUE
}

enum GroundReportStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  BULK_IMPORT
  EXPORT
  LOGIN
  LOGOUT
}

enum NotificationType {
  TASK_ASSIGNED
  VOTE_UPDATE
  REPORT_CREATED
  CADRE_ASSIGNED
  IMPORT_COMPLETE
  ALERT_TRIGGERED
  SYSTEM
}

enum ImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ----------------------------------------------------------------------------
// 1. ORGANISATION & MULTI-TENANCY
// ----------------------------------------------------------------------------

model Organisation {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique
  name            String
  description     String?
  logoUrl         String?
  website         String?
  isActive        Boolean          @default(true)
  parties         PoliticalParty[]
  states          State[]
  users           User[]
  roles           Role[]
  cmsConfigs      CMSConfiguration[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([code])
  @@index([isActive])
}

// ----------------------------------------------------------------------------
// 2. POLITICAL PARTY & 3. PARTY BRANDING
// ----------------------------------------------------------------------------

model PoliticalParty {
  id              String            @id @default(uuid()) @db.Uuid
  organisationId  String?           @db.Uuid
  organisation    Organisation?     @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  code            String            @unique
  name            String
  shortName       String
  symbolName      String?
  primaryColor    String            @default("#eab308")
  secondaryColor  String?           @default("#1e293b")
  accentColor     String?           @default("#3b82f6")
  logoUrl         String?
  flagUrl         String?
  sortOrder       Int               @default(0)
  isActive        Boolean           @default(true)
  lifecycleStatus String            @default("LOCKED") // DRAFT, PUBLISHED, LOCKED
  isLocked        Boolean           @default(true)
  publishedAt     DateTime?
  brandings       PartyBranding[]
  voterPreferences Voter[]          @relation("VoterPartyPreference")
  performances    PartyPerformance[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([code])
  @@index([isActive])
  @@index([isLocked])
  @@index([lifecycleStatus])
  @@index([organisationId])
}

model PartyBranding {
  id              String         @id @default(uuid()) @db.Uuid
  partyId         String         @db.Uuid
  party           PoliticalParty @relation(fields: [partyId], references: [id], onDelete: Cascade)
  title           String
  slogan          String?
  headerBannerUrl String?
  themeSettings   Json?
  leaderNames     String[]       @default([])
  socialLinks     Json?
  isDefault       Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([partyId])
  @@index([isDefault])
}

// ----------------------------------------------------------------------------
// 4. STATE -> 5. ZONE -> 6. PARLIAMENT -> 7. CONSTITUENCY
// 8. MANDAL -> 9. VILLAGE -> 10. BOOTH -> VOTER GROUP
// ----------------------------------------------------------------------------

model State {
  id              String           @id @default(uuid()) @db.Uuid
  organisationId  String?          @db.Uuid
  organisation    Organisation?    @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  name            String
  code            String           @unique
  capital         String?
  totalVoters     Int              @default(0)
  zones           Zone[]
  voters          Voter[]
  users           UserHierarchyAssignment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([code])
  @@index([organisationId])
}

model Zone {
  id              String           @id @default(uuid()) @db.Uuid
  stateId         String           @db.Uuid
  state           State            @relation(fields: [stateId], references: [id], onDelete: Cascade)
  name            String
  code            String           @unique
  headquarters    String?
  totalVoters     Int              @default(0)
  parliaments     Parliament[]
  voters          Voter[]
  users           UserHierarchyAssignment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([stateId])
  @@index([code])
}

model Parliament {
  id              String           @id @default(uuid()) @db.Uuid
  zoneId          String           @db.Uuid
  zone            Zone             @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name            String
  code            String           @unique
  parliamentNumber Int?
  totalVoters     Int              @default(0)
  constituencies  Constituency[]
  voters          Voter[]
  users           UserHierarchyAssignment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([zoneId])
  @@index([code])
}

model Constituency {
  id              String           @id @default(uuid()) @db.Uuid
  parliamentId    String           @db.Uuid
  parliament      Parliament       @relation(fields: [parliamentId], references: [id], onDelete: Cascade)
  name            String
  code            String           @unique
  constituencyNumber Int?
  isReservedSC    Boolean          @default(false)
  isReservedST    Boolean          @default(false)
  totalVoters     Int              @default(0)
  mandals         Mandal[]
  voters          Voter[]
  users           UserHierarchyAssignment[]
  tasks           Task[]           @relation("ConstituencyTasks")
  reports         GroundReport[]
  projections     ElectionProjection[]
  partyPerformances PartyPerformance[]
  aiInsights      AIInsight[]
  newsArticles    NewsArticle[]
  socialTrends    SocialTrend[]
  dataImports     DataImport[]     @relation("ConstituencyDataImports")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([parliamentId])
  @@index([code])
}

model Mandal {
  id              String           @id @default(uuid()) @db.Uuid
  constituencyId  String           @db.Uuid
  constituency    Constituency     @relation(fields: [constituencyId], references: [id], onDelete: Cascade)
  name            String
  code            String           @unique
  mandalNumber    Int?
  totalVoters     Int              @default(0)
  villages        Village[]
  voters          Voter[]
  users           UserHierarchyAssignment[]
  reports         GroundReport[]
  tasks           Task[]           @relation("MandalTasks")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([constituencyId])
  @@index([code])
}

model Village {
  id              String           @id @default(uuid()) @db.Uuid
  mandalId        String           @db.Uuid
  mandal          Mandal           @relation(fields: [mandalId], references: [id], onDelete: Cascade)
  name            String
  code            String           @unique
  isPanchayat     Boolean          @default(true)
  totalVoters     Int              @default(0)
  booths          Booth[]
  voters          Voter[]
  users           UserHierarchyAssignment[]
  reports         GroundReport[]
  tasks           Task[]           @relation("VillageTasks")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([mandalId])
  @@index([code])
}

model Booth {
  id              String           @id @default(uuid()) @db.Uuid
  villageId       String           @db.Uuid
  village         Village          @relation(fields: [villageId], references: [id], onDelete: Cascade)
  boothNumber     String
  code            String           @unique
  name            String
  pollingStation  String?
  locationCoordinates Json?
  totalVoters     Int              @default(0)
  voterGroups     VoterGroup[]
  voters          Voter[]
  users           UserHierarchyAssignment[]
  cadreAssignments CadreAssignment[]
  pollingReports  PollingReport[]
  reports         GroundReport[]
  tasks           Task[]           @relation("BoothTasks")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([villageId])
  @@index([code])
  @@index([boothNumber])
}

model VoterGroup {
  id              String           @id @default(uuid()) @db.Uuid
  boothId         String           @db.Uuid
  booth           Booth            @relation(fields: [boothId], references: [id], onDelete: Cascade)
  name            String
  code            String           @unique
  rangeStart      Int              @default(1)
  rangeEnd        Int              @default(100)
  totalVoters     Int              @default(100)
  assignedInchargeId String?       @db.Uuid
  assignedIncharge   User?         @relation("InchargeVoterGroups", fields: [assignedInchargeId], references: [id], onDelete: SetNull)
  voters          Voter[]
  users           UserHierarchyAssignment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([boothId])
  @@index([code])
  @@index([assignedInchargeId])
}

// Generic recursive node for unified tree traversal & aggregations
model OrganizationUnit {
  id              String              @id @default(uuid()) @db.Uuid
  name            String
  code            String?             @unique
  level           OrgHierarchyLevel
  totalVoters     Int                 @default(0)
  metadata        Json?
  parentId        String?             @db.Uuid
  parent          OrganizationUnit?   @relation("OrganizationTree", fields: [parentId], references: [id], onDelete: Cascade)
  children        OrganizationUnit[]  @relation("OrganizationTree")
  users           User[]
  voters          Voter[]             @relation("UnitVoters")
  tasks           Task[]              @relation("UnitTasks")
  reports         GroundReport[]      @relation("UnitReports")
  trainings       TrainingVideo[]     @relation("UnitTrainings")
  liveVoteEvents  LiveVoteEvent[]
  pollingReports  PollingReport[]     @relation("UnitPollingReports")
  cadreAssignments CadreAssignment[]  @relation("UnitCadres")
  importJobs      ImportJob[]
  aggregateCache  AggregateCache?
  sourceTasks     Task[]              @relation("TaskSourceUnit")
  polls           Poll[]              @relation("UnitPolls")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([level])
  @@index([parentId])
}

// ----------------------------------------------------------------------------
// 11. USER, 12. ROLE & 13. USER HIERARCHY ASSIGNMENT
// ----------------------------------------------------------------------------

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  organisationId  String?          @db.Uuid
  organisation    Organisation?    @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  name            String           @unique
  code            RoleType         @unique
  description     String?
  hierarchyLevel  OrgHierarchyLevel
  permissions     Json?            @default("[]")
  users           User[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([code])
  @@index([hierarchyLevel])
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  organisationId      String?              @db.Uuid
  organisation        Organisation?        @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  userCode            String               @unique
  name                String
  mobileNumber        String               @unique
  email               String?
  passwordHash        String?
  roleId              String?              @db.Uuid
  roleRef             Role?                @relation(fields: [roleId], references: [id], onDelete: SetNull)
  role                RoleType             @default(VOTER_100_INCHARGE)
  accountStatus       AccountStatus        @default(ACTIVE)
  isVerified          Boolean              @default(false)
  profilePictureUrl   String?
  unitId              String?              @db.Uuid
  unit                OrganizationUnit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  
  // Direct hierarchy assignments
  hierarchyAssignments UserHierarchyAssignment[]
  managedVoterGroups  VoterGroup[]         @relation("InchargeVoterGroups")
  assignedVoters      Voter[]              @relation("AssignedInchargeVoters")
  updatedVoters       Voter[]              @relation("UpdatedByVoters")
  assignedTasks       TaskAssignment[]     @relation("TaskAssignee")
  directAssignedTasks Task[]               @relation("DirectTaskAssignee")
  createdTasks        Task[]               @relation("TaskCreator")
  groundReports       GroundReport[]       @relation("ReportCreator")
  trainingProgress    TrainingProgress[]
  assignedTrainings   TrainingProgress[]   @relation("TrainingAssignedBy")
  voteEvents          LiveVoteEvent[]
  voteTrackings       VoteTracking[]       @relation("MarkedVotes")
  fakeVoterFlags      FakeVoterFlag[]      @relation("FlaggedByUser")
  fakeVoterResolutions FakeVoterFlag[]     @relation("ResolvedByUser")
  pollingReports      PollingReport[]      @relation("ReportedByUser")
  cadreProfile        Cadre?
  cadreAssignments    CadreAssignment[]    @relation("CadreAssignee")
  createdCadreAssignments CadreAssignment[] @relation("CadreAssignedBy")
  auditLogs           AuditLog[]
  notifications       Notification[]
  sessions            LoginSession[]
  devices             UserDevice[]
  otpVerifications    OTPVerification[]
  importJobs          ImportJob[]
  dataImports         DataImport[]         @relation("DataImportUploader")
  createdPolls        Poll[]               @relation("PollCreator")
  pollVotes           PollVote[]           @relation("UserPollVotes")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([userCode])
  @@index([mobileNumber])
  @@index([role])
  @@index([accountStatus])
  @@index([unitId])
}

model UserHierarchyAssignment {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleType        RoleType
  stateId         String?          @db.Uuid
  state           State?           @relation(fields: [stateId], references: [id], onDelete: Cascade)
  zoneId          String?          @db.Uuid
  zone            Zone?            @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  parliamentId    String?          @db.Uuid
  parliament      Parliament?      @relation(fields: [parliamentId], references: [id], onDelete: Cascade)
  constituencyId  String?          @db.Uuid
  constituency    Constituency?    @relation(fields: [constituencyId], references: [id], onDelete: Cascade)
  mandalId        String?          @db.Uuid
  mandal          Mandal?          @relation(fields: [mandalId], references: [id], onDelete: Cascade)
  villageId       String?          @db.Uuid
  village         Village?         @relation(fields: [villageId], references: [id], onDelete: Cascade)
  boothId         String?          @db.Uuid
  booth           Booth?           @relation(fields: [boothId], references: [id], onDelete: Cascade)
  voterGroupId    String?          @db.Uuid
  voterGroup      VoterGroup?      @relation(fields: [voterGroupId], references: [id], onDelete: Cascade)
  isActive        Boolean          @default(true)
  assignedAt      DateTime         @default(now())

  @@index([userId])
  @@index([roleType])
  @@index([constituencyId])
  @@index([mandalId])
  @@index([villageId])
  @@index([boothId])
  @@index([voterGroupId])
}

// ----------------------------------------------------------------------------
// 14. VOTER, 15. VOTER ASSIGNMENT & 16. VOTER STATUS HISTORY
// ----------------------------------------------------------------------------

model Voter {
  id                  String               @id @default(uuid()) @db.Uuid
  serialNumber        Int
  epicNumber          String               @unique
  name                String
  fatherHusbandName   String
  relationType        RelationType         @default(FATHER)
  houseNumber         String
  age                 Int
  gender              Gender               @default(MALE)
  mobileNumber        String?
  
  // Geographical Hierarchy Direct Links
  stateId             String?              @db.Uuid
  state               State?               @relation(fields: [stateId], references: [id], onDelete: SetNull)
  zoneId              String?              @db.Uuid
  zone                Zone?                @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  parliamentId        String?              @db.Uuid
  parliament          Parliament?          @relation(fields: [parliamentId], references: [id], onDelete: SetNull)
  constituencyId      String?              @db.Uuid
  constituency        Constituency?        @relation(fields: [constituencyId], references: [id], onDelete: SetNull)
  mandalId            String?              @db.Uuid
  mandal              Mandal?              @relation(fields: [mandalId], references: [id], onDelete: SetNull)
  villageId           String?              @db.Uuid
  village             Village?             @relation(fields: [villageId], references: [id], onDelete: SetNull)
  boothId             String?              @db.Uuid
  booth               Booth?               @relation(fields: [boothId], references: [id], onDelete: SetNull)
  voterGroupId        String?              @db.Uuid
  voterGroup          VoterGroup?          @relation(fields: [voterGroupId], references: [id], onDelete: SetNull)
  unitId              String?              @db.Uuid
  unit                OrganizationUnit?    @relation("UnitVoters", fields: [unitId], references: [id], onDelete: SetNull)

  // In-charge Assignment
  assignedInchargeId  String?              @db.Uuid
  assignedIncharge    User?                @relation("AssignedInchargeVoters", fields: [assignedInchargeId], references: [id], onDelete: SetNull)
  
  // Demographics
  casteCategoryId     String?              @db.Uuid
  casteCategory       CasteCategory?       @relation(fields: [casteCategoryId], references: [id], onDelete: SetNull)
  voterCasteId        String?              @db.Uuid
  voterCaste          VoterCaste?          @relation(fields: [voterCasteId], references: [id], onDelete: SetNull)
  caste               String?
  subCaste            String?
  profession          String?

  // Political Leanings & Statuses
  politicalPartyId    String?              @db.Uuid
  politicalParty      PoliticalParty?      @relation("VoterPartyPreference", fields: [politicalPartyId], references: [id], onDelete: SetNull)
  politicalPreference String               @default("NEUTRAL")
  voterStatus         VoterStatus          @default(ACTIVE)
  surveyStatus        SurveyStatus         @default(NOT_SURVEYED)
  locationStatus      VoterLocationStatus  @default(LOCAL)
  voterLocationStatus VoterLocationStatus  @default(LOCAL)
  migrationCity       String?
  migrationState      String?
  currentLocation     String?
  
  // Live Vote Tracking
  voteStatus          VoteStatus           @default(NOT_VOTED)
  voteDoneAt          DateTime?
  voteDoneTime        DateTime?
  inchargeAssessment  String?
  notes               String?
  
  // Relational sub-models
  assignments         VoterAssignment[]
  statusHistory       VoterStatusHistory[]
  fakeVoterFlags      FakeVoterFlag[]
  migrations          VoterMigration[]
  voteTrackings       VoteTracking[]
  liveVoteEvents      LiveVoteEvent[]
  
  updatedById         String?              @db.Uuid
  updatedBy           User?                @relation("UpdatedByVoters", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([epicNumber])
  @@index([mobileNumber])
  @@index([stateId])
  @@index([zoneId])
  @@index([parliamentId])
  @@index([constituencyId])
  @@index([mandalId])
  @@index([villageId])
  @@index([boothId])
  @@index([voterGroupId])
  @@index([assignedInchargeId])
  @@index([voterStatus])
  @@index([voteStatus])
  @@index([locationStatus])
  @@index([voterLocationStatus])
  @@index([politicalPreference])
  @@index([caste])
}

model VoterAssignment {
  id              String           @id @default(uuid()) @db.Uuid
  voterId         String           @db.Uuid
  voter           Voter            @relation(fields: [voterId], references: [id], onDelete: Cascade)
  voterGroupId    String?          @db.Uuid
  assignedUserId  String?          @db.Uuid
  assignedDate    DateTime         @default(now())
  unassignedDate  DateTime?
  isActive        Boolean          @default(true)
  notes           String?

  @@index([voterId])
  @@index([assignedUserId])
  @@index([isActive])
}

model VoterStatusHistory {
  id              String           @id @default(uuid()) @db.Uuid
  voterId         String           @db.Uuid
  voter           Voter            @relation(fields: [voterId], references: [id], onDelete: Cascade)
  previousStatus  VoterStatus
  newStatus       VoterStatus
  reason          String?
  changedById     String?          @db.Uuid
  changedAt       DateTime         @default(now())

  @@index([voterId])
  @@index([changedAt])
}

// ----------------------------------------------------------------------------
// 17. FAKE VOTER FLAG, 18. VOTER MIGRATION & 19. VOTE TRACKING
// ----------------------------------------------------------------------------

model FakeVoterFlag {
  id              String           @id @default(uuid()) @db.Uuid
  voterId         String           @db.Uuid
  voter           Voter            @relation(fields: [voterId], references: [id], onDelete: Cascade)
  reason          String
  evidenceUrl     String?
  status          FakeVoterStatus  @default(FLAGGED)
  flaggedById     String           @db.Uuid
  flaggedBy       User             @relation("FlaggedByUser", fields: [flaggedById], references: [id], onDelete: Cascade)
  flaggedAt       DateTime         @default(now())
  resolvedById    String?          @db.Uuid
  resolvedBy      User?            @relation("ResolvedByUser", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNotes String?
  resolvedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([voterId])
  @@index([flaggedById])
  @@index([status])
  @@index([flaggedAt])
}

model VoterMigration {
  id                String              @id @default(uuid()) @db.Uuid
  voterId           String              @db.Uuid
  voter             Voter               @relation(fields: [voterId], references: [id], onDelete: Cascade)
  status            VoterLocationStatus @default(MIGRATED)
  destinationCity   String
  destinationState  String?
  destinationCountry String?            @default("India")
  contactInCity     String?
  travelRequired    Boolean             @default(false)
  transportArranged Boolean             @default(false)
  returnPlannedDate DateTime?
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([voterId])
  @@index([destinationCity])
  @@index([status])
}

model VoteTracking {
  id              String           @id @default(uuid()) @db.Uuid
  voterId         String           @db.Uuid
  voter           Voter            @relation(fields: [voterId], references: [id], onDelete: Cascade)
  status          VoteStatus       @default(VOTE_DONE)
  markedById      String           @db.Uuid
  markedBy        User             @relation("MarkedVotes", fields: [markedById], references: [id], onDelete: Cascade)
  markedAt        DateTime         @default(now())
  verificationMethod String?        @default("INCHARGE_CONFIRMATION")
  notes           String?

  @@index([voterId])
  @@index([markedById])
  @@index([markedAt])
}

model LiveVoteEvent {
  id              String           @id @default(uuid()) @db.Uuid
  previousStatus  VoteStatus
  nextStatus      VoteStatus
  changedAt       DateTime         @default(now())
  voterId         String           @db.Uuid
  voter           Voter            @relation(fields: [voterId], references: [id], onDelete: Cascade)
  unitId          String?          @db.Uuid
  unit            OrganizationUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  inchargeId      String           @db.Uuid
  incharge        User             @relation(fields: [inchargeId], references: [id], onDelete: Cascade)

  @@index([unitId, changedAt])
  @@index([inchargeId, changedAt])
  @@index([voterId, changedAt])
}

// ----------------------------------------------------------------------------
// 20. CADRE & 21. CADRE ASSIGNMENT
// ----------------------------------------------------------------------------

model Cadre {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @unique @db.Uuid
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills          String[]         @default([])
  badges          String[]         @default([])
  performanceScore Float           @default(85.0)
  totalAssignedVoters Int          @default(0)
  votedCoveredCount   Int          @default(0)
  tasksCompletedCount Int          @default(0)
  trainingCompletedCount Int       @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([performanceScore])
}

model CadreAssignment {
  id              String           @id @default(uuid()) @db.Uuid
  boothId         String?          @db.Uuid
  booth           Booth?           @relation(fields: [boothId], references: [id], onDelete: SetNull)
  unitId          String?          @db.Uuid
  unit            OrganizationUnit? @relation("UnitCadres", fields: [unitId], references: [id], onDelete: SetNull)
  slotIndex       Int              @default(0)
  roleTitle       String?
  assigneeUserId  String?          @db.Uuid
  assigneeUser    User?            @relation("CadreAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  assignedById    String?          @db.Uuid
  assignedBy      User?            @relation("CadreAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([boothId])
  @@index([assigneeUserId])
}

// ----------------------------------------------------------------------------
// 22. TASK, 23. TASK ASSIGNMENT & 24. TASK STATUS HISTORY
// ----------------------------------------------------------------------------

model Task {
  id              String           @id @default(uuid()) @db.Uuid
  title           String
  description     String?
  instructions    String?
  assignedBy      String?
  priority        TaskPriority     @default(MEDIUM)
  status          TaskStatus       @default(PENDING)
  dueDate         DateTime?
  sourceLevel     OrgHierarchyLevel @default(CONSTITUENCY)
  targetLevel     OrgHierarchyLevel @default(VOTER_GROUP)
  
  sourceUnitId    String?          @db.Uuid
  sourceUnit      OrganizationUnit? @relation("TaskSourceUnit", fields: [sourceUnitId], references: [id], onDelete: SetNull)
  assigneeId      String?          @db.Uuid
  assignee        User?            @relation("DirectTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  constituencyId  String?          @db.Uuid
  constituency    Constituency?    @relation("ConstituencyTasks", fields: [constituencyId], references: [id], onDelete: SetNull)
  mandalId        String?          @db.Uuid
  mandal          Mandal?          @relation("MandalTasks", fields: [mandalId], references: [id], onDelete: SetNull)
  villageId       String?          @db.Uuid
  village         Village?         @relation("VillageTasks", fields: [villageId], references: [id], onDelete: SetNull)
  boothId         String?          @db.Uuid
  booth           Booth?           @relation("BoothTasks", fields: [boothId], references: [id], onDelete: SetNull)
  unitId          String?          @db.Uuid
  unit            OrganizationUnit? @relation("UnitTasks", fields: [unitId], references: [id], onDelete: SetNull)

  createdById     String?          @db.Uuid
  createdBy       User?            @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignments     TaskAssignment[]
  statusHistory   TaskStatusHistory[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([priority])
  @@index([status])
  @@index([dueDate])
  @@index([createdById])
  @@index([assigneeId])
  @@index([sourceUnitId])
  @@index([constituencyId])
}

model TaskAssignment {
  id              String           @id @default(uuid()) @db.Uuid
  taskId          String           @db.Uuid
  task            Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId          String           @db.Uuid
  user            User             @relation("TaskAssignee", fields: [userId], references: [id], onDelete: Cascade)
  status          TaskStatus       @default(PENDING)
  completedAt     DateTime?
  comments        String?
  assignedAt      DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
  @@index([status])
}

model TaskStatusHistory {
  id              String           @id @default(uuid()) @db.Uuid
  taskId          String           @db.Uuid
  task            Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  previousStatus  TaskStatus
  newStatus       TaskStatus
  notes           String?
  changedById     String?          @db.Uuid
  changedAt       DateTime         @default(now())

  @@index([taskId])
  @@index([changedAt])
}

// ----------------------------------------------------------------------------
// 25. TRAINING VIDEO, 26. TRAINING ASSIGNMENT & 27. TRAINING PROGRESS
// ----------------------------------------------------------------------------

model TrainingVideo {
  id              String               @id @default(uuid()) @db.Uuid
  title           String
  description     String
  category        String
  duration        String
  videoUrl        String?
  youtubeId       String?
  thumbnailUrl    String?
  sortOrder       Int                  @default(0)
  isActive        Boolean              @default(true)
  unitId          String?              @db.Uuid
  unit            OrganizationUnit?    @relation("UnitTrainings", fields: [unitId], references: [id], onDelete: SetNull)
  assignments     TrainingAssignment[]
  progress        TrainingProgress[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([category])
  @@index([isActive])
}

model TrainingAssignment {
  id              String           @id @default(uuid()) @db.Uuid
  videoId         String           @db.Uuid
  video           TrainingVideo    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  targetRole      RoleType?
  assignedAt      DateTime         @default(now())

  @@index([videoId])
}

model TrainingProgress {
  id              String           @id @default(uuid()) @db.Uuid
  status          TrainingStatus   @default(ASSIGNED)
  watchedAt       DateTime?
  completedAt     DateTime?
  quizScore       Int?
  notes           String?
  userId          String           @db.Uuid
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId         String           @db.Uuid
  video           TrainingVideo    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  assignedById    String?          @db.Uuid
  assignedBy      User?            @relation("TrainingAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([userId, videoId])
  @@index([userId])
  @@index([videoId])
  @@index([status])
}

// ----------------------------------------------------------------------------
// 28. CASTE CATEGORY & 29. VOTER CASTE
// ----------------------------------------------------------------------------

model CasteCategory {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique
  name            String
  description     String?
  subCastes       VoterCaste[]
  voters          Voter[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([code])
}

model VoterCaste {
  id              String           @id @default(uuid()) @db.Uuid
  categoryId      String           @db.Uuid
  category        CasteCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name            String
  code            String           @unique
  aliases         String[]         @default([])
  voters          Voter[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([categoryId])
  @@index([code])
}

// ----------------------------------------------------------------------------
// 30. GROUND REPORT & 31. POLLING REPORT
// ----------------------------------------------------------------------------

model GroundReport {
  id                  String             @id @default(uuid()) @db.Uuid
  reportType          GroundReportType   @default(GENERAL_UPDATE)
  priority            TaskPriority       @default(MEDIUM)
  description         String
  issueCategory       String?
  affectedVotersCount Int?
  status              GroundReportStatus @default(PENDING)
  resolutionNotes     String?
  
  constituencyId      String?            @db.Uuid
  constituency        Constituency?      @relation(fields: [constituencyId], references: [id], onDelete: SetNull)
  mandalId            String?            @db.Uuid
  mandal              Mandal?            @relation(fields: [mandalId], references: [id], onDelete: SetNull)
  villageId           String?            @db.Uuid
  village             Village?           @relation(fields: [villageId], references: [id], onDelete: SetNull)
  boothId             String?            @db.Uuid
  booth               Booth?             @relation(fields: [boothId], references: [id], onDelete: SetNull)
  unitId              String?            @db.Uuid
  unit                OrganizationUnit?  @relation("UnitReports", fields: [unitId], references: [id], onDelete: SetNull)

  createdById         String             @db.Uuid
  createdBy           User               @relation("ReportCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([reportType])
  @@index([priority])
  @@index([status])
  @@index([createdById])
  @@index([constituencyId])
}

model PollingReport {
  id              String           @id @default(uuid()) @db.Uuid
  mandalName      String
  boothLabel      String
  reporterName    String
  tdpVotes        Int              @default(0)
  ysrcpVotes      Int              @default(0)
  jspVotes        Int              @default(0)
  bjpVotes        Int              @default(0)
  incVotes        Int              @default(0)
  othersVotes     Int              @default(0)
  totalVotes      Int              @default(0)
  
  boothId         String?          @db.Uuid
  booth           Booth?           @relation(fields: [boothId], references: [id], onDelete: SetNull)
  unitId          String?          @db.Uuid
  unit            OrganizationUnit? @relation("UnitPollingReports", fields: [unitId], references: [id], onDelete: SetNull)
  
  createdById     String           @db.Uuid
  createdBy       User             @relation("ReportedByUser", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([boothId, createdAt])
  @@index([createdById, createdAt])
}

// ----------------------------------------------------------------------------
// 32. PARTY PERFORMANCE & 33. ELECTION PROJECTION
// ----------------------------------------------------------------------------

model PartyPerformance {
  id              String           @id @default(uuid()) @db.Uuid
  constituencyId  String           @db.Uuid
  constituency    Constituency     @relation(fields: [constituencyId], references: [id], onDelete: Cascade)
  partyId         String           @db.Uuid
  party           PoliticalParty   @relation(fields: [partyId], references: [id], onDelete: Cascade)
  electionYear    Int              @default(2024)
  projectedVotes  Int              @default(0)
  confirmedVotes  Int              @default(0)
  swingPercentage Float            @default(0.0)
  status          String           @default("WINNING")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([constituencyId, electionYear])
  @@index([partyId])
}

model ElectionProjection {
  id              String           @id @default(uuid()) @db.Uuid
  constituencyId  String           @db.Uuid
  constituency    Constituency     @relation(fields: [constituencyId], references: [id], onDelete: Cascade)
  totalElectorate Int
  projectedTurnout Float
  leadingPartyCode String
  leadMarginVotes  Int
  confidenceScore  Float           @default(0.92)
  insightsSummary  String?
  scenarioData     Json?
  computedAt       DateTime        @default(now())

  @@index([constituencyId, computedAt])
}

// ----------------------------------------------------------------------------
// 34. ANNOUNCEMENT & 35. NOTIFICATION
// ----------------------------------------------------------------------------

model Announcement {
  id              String           @id @default(uuid()) @db.Uuid
  title           String
  content         String
  priority        TaskPriority     @default(HIGH)
  targetRole      RoleType?
  targetLevel     OrgHierarchyLevel?
  expiresAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([priority])
  @@index([createdAt])
}

model Notification {
  id              String           @id @default(uuid()) @db.Uuid
  type            NotificationType
  title           String
  message         String
  userId          String           @db.Uuid
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt          DateTime?
  metadata        Json?
  createdAt       DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ----------------------------------------------------------------------------
// 36. AI INSIGHT, 37. NEWS ARTICLE & 38. SOCIAL TREND
// ----------------------------------------------------------------------------

model AIInsight {
  id              String           @id @default(uuid()) @db.Uuid
  constituencyId  String?          @db.Uuid
  constituency    Constituency?    @relation(fields: [constituencyId], references: [id], onDelete: SetNull)
  category        String           @default("STRATEGY")
  title           String
  content         String
  sentimentScore  Float            @default(0.75)
  recommendedAction String?
  tags            String[]         @default([])
  createdAt       DateTime         @default(now())

  @@index([category])
  @@index([constituencyId])
}

model NewsArticle {
  id              String           @id @default(uuid()) @db.Uuid
  constituencyId  String?          @db.Uuid
  constituency    Constituency?    @relation(fields: [constituencyId], references: [id], onDelete: SetNull)
  headline        String
  sourceName      String
  articleUrl      String?
  snippet         String?
  sentiment       String           @default("POSITIVE")
  publishedAt     DateTime         @default(now())
  createdAt       DateTime         @default(now())

  @@index([constituencyId])
  @@index([publishedAt])
}

model SocialTrend {
  id              String           @id @default(uuid()) @db.Uuid
  constituencyId  String?          @db.Uuid
  constituency    Constituency?    @relation(fields: [constituencyId], references: [id], onDelete: SetNull)
  hashtag         String
  platform        String           @default("X / Twitter")
  mentionCount    Int              @default(0)
  sentimentPct    Float            @default(70.0)
  trendingRank    Int              @default(1)
  recordedAt      DateTime         @default(now())

  @@index([constituencyId])
  @@index([recordedAt])
}

// ----------------------------------------------------------------------------
// 39. AUDIT LOG, 40. LOGIN SESSION & 41. OTP VERIFICATION
// ----------------------------------------------------------------------------

model AuditLog {
  id              String           @id @default(uuid()) @db.Uuid
  action          AuditAction
  entityType      String
  entityId        String
  userId          String           @db.Uuid
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId          String?          @db.Uuid
  changes         Json?
  metadata        Json?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime         @default(now())

  @@index([entityType, entityId])
  @@index([userId, createdAt])
}

model LoginSession {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash       String           @unique
  deviceInfo      String?
  ipAddress       String?
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime         @default(now())

  @@index([userId, expiresAt])
}

model UserDevice {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId        String
  deviceName      String?
  ipAddress       String?
  userAgent       String?
  isAuthorized    Boolean          @default(true)
  deviceTokenHash String
  lastActiveAt    DateTime         @default(now())
  revokedAt       DateTime?
  revokedReason   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([userId, deviceId])
  @@index([deviceId])
  @@index([userId, isAuthorized])
}

model OTPVerification {
  id              String           @id @default(uuid()) @db.Uuid
  mobileNumber    String
  role            RoleType
  otpCode         String
  attempts        Int              @default(0)
  expiresAt       DateTime
  verifiedAt      DateTime?
  userId          String?          @db.Uuid
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())

  @@index([mobileNumber, role, createdAt])
  @@index([userId])
}

// ----------------------------------------------------------------------------
// 42. CMS CONFIGURATION, IMPORT JOBS & AGGREGATE CACHE
// ----------------------------------------------------------------------------

model CMSConfiguration {
  id              String           @id @default(uuid()) @db.Uuid
  organisationId  String?          @db.Uuid
  organisation    Organisation?    @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  configKey       String           @unique @default("default")
  organisationName String
  stateName       String
  defaultLanguage String           @default("en")
  headerTitle     String?
  slogan          String?
  logoUrl         String?          @db.Text
  faviconUrl      String?
  primaryColor    String?
  secondaryColor  String?
  accentColor     String?
  activePartyCode String?
  appScope        String?          @default("SINGLE_MLA")
  parliamentName  String?
  parliamentCode  String?
  candidateName   String?
  hierarchyLabels Json
  featureToggles  Json
  activeHierarchyLevels Json?
  dashboardConfig Json?
  analyticsConfig Json?
  aiEnabled       Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([configKey])
  @@index([organisationId])
}

model ImportJob {
  id              String           @id @default(uuid()) @db.Uuid
  status          ImportJobStatus  @default(PENDING)
  fileName        String
  unitId          String?          @db.Uuid
  unit            OrganizationUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  createdById     String           @db.Uuid
  createdBy       User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  totalRows       Int              @default(0)
  successCount    Int              @default(0)
  errorCount      Int              @default(0)
  errors          Json?
  payload         Json?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([createdById])
  @@index([status])
}

model DataImport {
  id                    String              @id @default(uuid()) @db.Uuid
  applicationId         String?             @db.Uuid
  uploadedById          String?             @db.Uuid
  uploadedBy            User?               @relation("DataImportUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  fileName              String
  fileSize              Int?                @default(0)
  targetHierarchyId     String?             @db.Uuid
  targetConstituencyId  String?             @db.Uuid
  targetConstituency    Constituency?       @relation("ConstituencyDataImports", fields: [targetConstituencyId], references: [id], onDelete: SetNull)
  mode                  String              @default("APPEND") // APPEND, REPLACE
  status                String              @default("PENDING") // PENDING, PROCESSING, SUCCESS, PARTIAL_SUCCESS, FAILED
  totalRecords          Int                 @default(0)
  validRecords          Int                 @default(0)
  importedRecords       Int                 @default(0)
  updatedRecords        Int                 @default(0)
  skippedRecords        Int                 @default(0)
  failedRecords         Int                 @default(0)
  boothsCount           Int                 @default(0)
  voterGroupsCount      Int                 @default(0)
  metadata              Json?
  startedAt             DateTime?
  completedAt           DateTime?
  errors                DataImportError[]
  mappings              DataImportMapping[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([applicationId])
  @@index([targetConstituencyId])
  @@index([status])
  @@index([createdAt])
}

model DataImportError {
  id            String      @id @default(uuid()) @db.Uuid
  importId      String      @db.Uuid
  import        DataImport  @relation(fields: [importId], references: [id], onDelete: Cascade)
  rowNumber     Int
  field         String
  value         String?
  errorMessage  String
  severity      String      @default("ERROR") // ERROR, WARNING
  createdAt     DateTime    @default(now())

  @@index([importId])
  @@index([severity])
}

model DataImportMapping {
  id            String      @id @default(uuid()) @db.Uuid
  importId      String      @db.Uuid
  import        DataImport  @relation(fields: [importId], references: [id], onDelete: Cascade)
  excelColumn   String
  systemField   String
  createdAt     DateTime    @default(now())

  @@index([importId])
}

model AggregateCache {
  id              String           @id @default(uuid()) @db.Uuid
  unitId          String           @unique @db.Uuid
  unit            OrganizationUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  snapshot        Json
  computedAt      DateTime         @default(now())
  expiresAt       DateTime

  @@index([expiresAt])
}

model Poll {
  id              String             @id @default(uuid()) @db.Uuid
  title           String
  description     String?
  targetLevel     OrgHierarchyLevel?
  unitId          String?            @db.Uuid
  unit            OrganizationUnit?  @relation("UnitPolls", fields: [unitId], references: [id], onDelete: SetNull)
  status          String             @default("PUBLISHED") // DRAFT, PUBLISHED, CLOSED
  expiresAt       DateTime?
  createdById     String?            @db.Uuid
  createdBy       User?              @relation("PollCreator", fields: [createdById], references: [id], onDelete: SetNull)
  options         PollOption[]
  votes           PollVote[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status])
  @@index([targetLevel])
  @@index([unitId])
}

model PollOption {
  id              String             @id @default(uuid()) @db.Uuid
  pollId          String             @db.Uuid
  poll            Poll               @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label           String
  order           Int                @default(0)
  votes           PollVote[]

  @@index([pollId])
}

model PollVote {
  id              String             @id @default(uuid()) @db.Uuid
  pollId          String             @db.Uuid
  poll            Poll               @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId        String             @db.Uuid
  option          PollOption         @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId          String             @db.Uuid
  user            User               @relation("UserPollVotes", fields: [userId], references: [id], onDelete: Cascade)
  votedAt         DateTime           @default(now())

  @@unique([pollId, userId])
  @@index([pollId])
  @@index([optionId])
  @@index([userId])
}

