# ==========================================
# DATABASE & INFRASTRUCTURE
# ==========================================
# Local Development default (PostgreSQL running locally):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kondapi_connect?schema=public"

# Production Neon Pooled connection (Set in Render environment settings):
# Format: postgresql://[user]:[password]@[endpoint]-pooler.[region].neon.tech/neondb?sslmode=require&pgbouncer=true
# DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.neon.tech/neondb?sslmode=require"

PORT=4000
HOST="0.0.0.0"
NODE_ENV="development" # Set to "production" in live Render / staging environments

# ==========================================
# DISTRIBUTED CACHE & MESSAGE BROKER (REDIS)
# ==========================================
# Optional in local dev (backend falls back gracefully to in-memory adapter when unset)
# Local dev example:
# REDIS_URL="redis://localhost:6379"

# Production Redis (Upstash / Render Native Redis over TLS):
# For Upstash: use standard TCP connection (not REST endpoint) starting with rediss://
# Format: rediss://default:[PASSWORD]@[ENDPOINT]:[PORT]
# REDIS_URL="rediss://default:samplepassword@sample-endpoint.upstash.io:6379"

# ==========================================
# SECURITY & AUTHENTICATION (MANDATORY IN PRODUCTION)
# ==========================================
# In production (NODE_ENV=production), backend strictly validates that secrets are at least 32 characters
# and not using default placeholders. Generate with: openssl rand -base64 32
JWT_SECRET="replace-with-cryptographically-random-32-chars-minimum-in-production"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="replace-with-cryptographically-random-32-chars-minimum-in-production"
JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_SECRET="replace-with-cryptographically-random-32-chars-minimum-in-production"
OTP_SECRET="replace-with-cryptographically-random-32-chars-minimum-in-production"

# Production: Comma-separated list of allowed origins (Vercel frontend and admin domains)
# e.g.: CORS_ORIGIN="https://viap-app.vercel.app,https://viap-admin.vercel.app"
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# ==========================================
# OTP & NOTIFICATION GATEWAYS
# ==========================================
SMS_PROVIDER="baileys"
ALLOW_MOCK_OTP="false" # Never set to true in production

# WhatsApp Baileys Local Gateway
WHATSAPP_PROVIDER="baileys"
WHATSAPP_BAILEYS_AUTH_DIR="./.baileys_auth"

# ==========================================
# PRODUCTION CLOUD STORAGE (AWS S3 — PHASE 4)
# ==========================================
# Local development defaults to local ./uploads directory.
# In Phase 4, production file uploads will use Amazon S3 with private access:
# AWS_REGION="ap-south-1"
# AWS_S3_BUCKET_NAME="viap-production-storage"
# AWS_ACCESS_KEY_ID="replace-with-iam-access-key-id"
# AWS_SECRET_ACCESS_KEY="replace-with-iam-secret-access-key"

# ==========================================
# AI & ANALYTICS (GOOGLE GEMINI)
# ==========================================
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
